{
  "name": "market-sentinel",
  "private": true,
  "version": "0.5.0",
  "publisher": "market-sentinel-local",
  "displayName": "Market Sentinel",
  "description": "Cursor host for Market Sentinel (v0.5 local VSIX)",
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Market Sentinel starts a local Python Core via uv in the workspace, so it requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "marketSentinel.pause",
        "title": "Market Sentinel: Pause Monitoring"
      },
      {
        "command": "marketSentinel.resume",
        "title": "Market Sentinel: Resume Monitoring"
      },
      {
        "command": "marketSentinel.restartCore",
        "title": "Market Sentinel: Restart Core"
      },
      {
        "command": "marketSentinel.showOutput",
        "title": "Market Sentinel: Show Output"
      },
      {
        "command": "marketSentinel.resetAlertBadge",
        "title": "Market Sentinel: Reset Alert Badge"
      }
    ],
    "configuration": {
      "title": "Market Sentinel",
      "properties": {
        "marketSentinel.coreRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the Market Sentinel Core checkout (directory containing pyproject.toml). Required when no single workspace folder is open."
        },
        "marketSentinel.uvPath": {
          "type": "string",
          "default": "uv",
          "description": "uv executable used to spawn the Python Core. Spawned with shell:false; no python/conda fallback."
        },
        "marketSentinel.watchlist": {
          "type": "array",
          "default": [],
          "description": "Host watchlist intent. Core enforces the 10-symbol limit and symbol validation.",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["symbol"],
                "properties": {
                  "symbol": { "type": "string" },
                  "enabled": { "type": "boolean", "default": true }
                }
              }
            ]
          }
        },
        "marketSentinel.provider": {
          "type": "string",
          "enum": ["fake", "replay", "longbridge"],
          "default": "fake",
          "description": "Core market data provider. longbridge uses process environment credentials (LONGBRIDGE_APP_KEY / SECRET / ACCESS_TOKEN). Do not put secrets in settings. http is a deprecated Core stub."
        },
        "marketSentinel.replayPath": {
          "type": "string",
          "default": "",
          "description": "Replay fixture path. Required when provider is replay."
        },
        "marketSentinel.enableHoverDetails": {
          "type": "boolean",
          "default": true,
          "description": "Show full market details in the StatusBar hover. Host-only; changing it does not restart the Python Core."
        },
        "marketSentinel.alertToast": {
          "type": "string",
          "enum": ["off", "critical"],
          "default": "off",
          "description": "Optional notification for unsolicited critical alert edges. Host-only; changing it does not restart the Python Core. Default off."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:extension-host": "tsc -p tsconfig.json && tsc -p tsconfig.integration.json && node ./out/test/runTest.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository && node ./scripts/audit-vsix.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.1",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.34.0",
    "mocha": "^11.7.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
